#!/bin/sed -Ef
# add-sed: "A B" -> A+B, any length. state c|A|B|R (carry, rest of A, rest of B, result)
s/^ *([0-9]+) +([0-9]+) *$/0|\1|\2|/
t l
s/.*/?/
b
:l
/^.\|\|\|/ b e
s/^(.)\|\|/\1|0|/
s/^(.)\|([0-9]+)\|\|/\1|\2|0|/
s/^(.)\|([0-9]*)([0-9])\|([0-9]*)([0-9])\|(.*)$/\1\3\5@\2|\4|\6/
:u
s/^([^@]*)0([^@]*@)/\1\2/
s/^([^@]*)1([^@]*@)/\1x\2/
s/^([^@]*)2([^@]*@)/\1xx\2/
s/^([^@]*)3([^@]*@)/\1xxx\2/
s/^([^@]*)4([^@]*@)/\1xxxx\2/
s/^([^@]*)5([^@]*@)/\1xxxxx\2/
s/^([^@]*)6([^@]*@)/\1xxxxxx\2/
s/^([^@]*)7([^@]*@)/\1xxxxxxx\2/
s/^([^@]*)8([^@]*@)/\1xxxxxxxx\2/
s/^([^@]*)9([^@]*@)/\1xxxxxxxxx\2/
t u
s/^x{10}(x*)@/1\1@/
t c
s/^(x*)@/0\1@/
:c
s/^(.)(x*)@([0-9]*)\|([0-9]*)\|([0-9]*)$/\1|\3|\4|\2,\5/
s/\|xxxxxxxxx,/|9/
s/\|xxxxxxxx,/|8/
s/\|xxxxxxx,/|7/
s/\|xxxxxx,/|6/
s/\|xxxxx,/|5/
s/\|xxxx,/|4/
s/\|xxx,/|3/
s/\|xx,/|2/
s/\|x,/|1/
s/\|,/|0/
b l
:e
s/^1\|\|\|/1/
s/^0\|\|\|//
s/^0+(.)/\1/
